<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- اسم التطبيق -->
  <key>CFBundleDisplayName</key>
  <string>مستمع</string>

  <!-- تشغيل الصوت في الخلفية -->
  <key>UIBackgroundModes</key>
  <array>
    <string>audio</string>
    <string>fetch</string>
  </array>

  <!-- صلاحية الوصول للملفات المحلية -->
  <key>NSDocumentsFolderUsageDescription</key>
  <string>مستمع يحتاج إلى الوصول للملفات لتشغيلها</string>

  <key>NSMicrophoneUsageDescription</key>
  <string>مستمع يحتاج صلاحية الميكروفون لدعم الصوت</string>

  <!-- دعم الشبكة المحلية -->
  <key>NSLocalNetworkUsageDescription</key>
  <string>مستمع يستخدم الشبكة للتحميل من يوتيوب</string>

  <!-- السماح بمحتوى HTTP عند الحاجة -->
  <key>NSAppTransportSecurity</key>
  <dict>
    <key>NSAllowsArbitraryLoads</key>
    <true/>
    <key>NSAllowsArbitraryLoadsInWebContent</key>
    <true/>
  </dict>

  <!-- دعم الاتجاه -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UISupportedInterfaceOrientations~ipad</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
    <string>UIInterfaceOrientationPortraitUpsideDown</string>
    <string>UIInterfaceOrientationLandscapeLeft</string>
    <string>UIInterfaceOrientationLandscapeRight</string>
  </array>

  <key>UILaunchStoryboardName</key>
  <string>LaunchScreen</string>

  <key>UIMainStoryboardFile</key>
  <string>Main</string>

  <key>CFBundlePackageType</key>
  <string>APPL</string>
</dict>
</plist>

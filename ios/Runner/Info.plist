<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<!-- معلومات التطبيق الأساسية -->
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>دندن</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>دندن</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<!-- التشغيل بالخلفية -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
		</array>
		<key>NSAppleMusicUsageDescription</key>
		<string>لعرض الصور المصغرة للأغاني</string>
		<!-- صلاحيات -->
		<key>NSDocumentsFolderUsageDescription</key>
		<string>دندن يحتاج إلى الوصول للملفات لتشغيلها</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>دندن يحتاج صلاحية الميكروفون لدعم الصوت</string>
		<key>NSLocalNetworkUsageDescription</key>
		<string>دندن يستخدم الشبكة للتحميل من يوتيوب</string>
		<key>NSPhotoLibraryAddUsageDescription</key>
		<string>يحتاج دندن إذنك لحفظ الوسائط في معرض الصور</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>يحتاج دندن إذنك للوصول لمعرض الصور</string>
		<!-- السماح بمحتوى HTTP -->
		<key>NSAppTransportSecurity</key>
		<dict>
			<key>NSAllowsArbitraryLoads</key>
			<true/>
			<key>NSAllowsArbitraryLoadsInWebContent</key>
			<true/>
		</dict>
		<!-- الاتجاهات -->
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- شاشة البداية -->
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<!-- دعم iOS Scene -->
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<!-- أيقونات التطبيق -->
		<key>CFBundleIcons</key>
		<dict>
			<!-- الأيقونة الأساسية -->
			<key>CFBundlePrimaryIcon</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon</string>
				<key>UIPrerenderedIcon</key>
				<false/>
			</dict>
			<!-- الأيقونات البديلة — يدوي فقط عبر setAlternateIconName -->
			<key>CFBundleAlternateIcons</key>
			<dict>
				<key>AppIconDark</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIconDark</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>CFBundleIcons~ipad</key>
		<dict>
			<key>CFBundlePrimaryIcon</key>
			<dict>
				<key>CFBundleIconName</key>
				<string>AppIcon</string>
			</dict>
			<key>CFBundleAlternateIcons</key>
			<dict>
				<key>AppIconDark</key>
				<dict>
					<key>CFBundleIconFiles</key>
					<array>
						<string>AppIconDark</string>
					</array>
					<key>UIPrerenderedIcon</key>
					<false/>
				</dict>
			</dict>
		</dict>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>


<key>NSCameraUsageDescription</key>
<string>يحتاج التطبيق إلى الوصول إلى الكاميرا لاستخدام الميزات التي تتطلب التقاط الصور أو الفيديو.</string>

<key>NSLocationWhenInUseUsageDescription</key>
<string>يحتاج التطبيق إلى الوصول إلى موقعك أثناء الاستخدام لتوفير الميزات التي تعتمد على الموقع.</string>

	</dict>
</plist>
